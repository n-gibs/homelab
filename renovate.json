{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "description": "Default prHourlyLimit of 2 starves the queue: only the four weekend cron runs can open PRs, so majors (sorted last) never win a slot. prConcurrentLimit is uncapped because updates are grouped per app directory, which already bounds open PRs at roughly one per app.",
  "prHourlyLimit": 6,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["ansible-galaxy"],
      "groupName": "ansible dependencies",
      "automerge": false
    },
    {
      "description": "One PR per app directory, so a chart bump and the image bump it pairs with land together. This also keeps Nextcloud, which cannot skip majors, out of any batch.",
      "matchManagers": ["custom.regex", "helm-values"],
      "matchFileNames": ["**/app.yaml", "**/values.yaml"],
      "groupName": "{{parentDir}}",
      "automerge": false
    },
    {
      "description": "Longhorn upgrades are an ordered procedure with version-specific notes per release, not a chart to bump on sight. dependencyDashboardApproval means no PR opens until it is ticked.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["system/longhorn-system/app.yaml"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "A k3s minor bump has to wait for Cilium to support that Kubernetes minor, so without this every patch release sits behind a minor PR that can't merge yet.",
      "matchDepNames": ["k3s-io/k3s"],
      "separateMinorPatch": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)app\\.yaml$/"],
      "matchStrings": [
        "chartName: (?<depName>[^\\n]+)\\nchartRepo: (?<registryUrl>https://[^\\n]+)\\nchartVersion: (?<currentValue>[^\\n]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)app\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\nchartName: [^\\n]+\\nchartRepo: [^\\n]+\\nchartVersion: (?<currentValue>[^\\n]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)values\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\n\\s*image:\\n\\s*tag: (?<currentValue>[^\\n]+)",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\n\\s*image:\\n\\s*repository: [^\\n]+\\n\\s*tag: (?<currentValue>[^\\n]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/ansible/group_vars/k3s_cluster\\.yml/"],
      "matchStrings": ["k3s_version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ]
}
