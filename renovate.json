{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["ansible-galaxy"],
      "groupName": "ansible dependencies",
      "automerge": false
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["**/app.yaml"],
      "groupName": "helm charts",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)app\\.yaml$"],
      "matchStrings": [
        "chartName: (?<depName>[^\\n]+)\\nchartRepo: (?<registryUrl>[^\\n]+)\\nchartVersion: (?<currentValue>[^\\n]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "fileMatch": ["ansible/group_vars/k3s_cluster\\.yml"],
      "matchStrings": ["k3s_version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ]
}
